{
  "functions": [{
    "source": "functions-partner-portal-authority",
    "codebase": "partner-portal-authority-v2",
    "disallowLegacyRuntimeConfig": true,
    "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log", "*.local"],
    "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build", "npm --prefix \"$RESOURCE_DIR\" run test"]
  }],
  "hosting": [{
    "target": "partner-portal-v2",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{"source": "**", "destination": "/index.html"}]
  }]
}
