rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /enterprise_authority_bindings/{document=**} { allow read, write: if false; }
    match /enterprise_authority_memberships/{document=**} { allow read, write: if false; }
    match /enterprise_authority_grants/{document=**} { allow read, write: if false; }
    match /enterprise_organizations/{document=**} { allow read, write: if false; }
    match /enterprise_properties/{document=**} { allow read, write: if false; }
    match /enterprise_courses/{document=**} { allow read, write: if false; }
    match /enterprise_authority_receipts/{document=**} { allow read, write: if false; }
    match /enterprise_authority_commands/{document=**} { allow read, write: if false; }
    match /enterprise_operation_commands/{document=**} { allow read, write: if false; }
    match /enterprise_course_profiles/{document=**} { allow read, write: if false; }
    match /enterprise_course_profile_attempts/{document=**} { allow read, write: if false; }
    match /enterprise_course_profile_counters/{document=**} { allow read, write: if false; }
    match /enterprise_course_profile_receipts/{document=**} { allow read, write: if false; }
    match /enterprise_member_links/{document=**} { allow read, write: if false; }
    match /enterprise_member_link_receipts/{document=**} { allow read, write: if false; }
    match /enterprise_verified_golfers/{document=**} { allow read, write: if false; }
    match /enterprise_onboarding_applications/{document=**} { allow read, write: if false; }
    match /enterprise_onboarding_commands/{document=**} { allow read, write: if false; }
    match /enterprise_onboarding_receipts/{document=**} { allow read, write: if false; }
    match /enterprise_agreement_policies/{document=**} { allow read, write: if false; }
    match /enterprise_economy_config/{document=**} { allow read, write: if false; }
    match /enterprise_economy_config_versions/{document=**} { allow read, write: if false; }
    match /enterprise_trial_offers/{document=**} { allow read, write: if false; }
    match /enterprise_trials/{document=**} { allow read, write: if false; }
    match /enterprise_support_requests/{document=**} { allow read, write: if false; }
    match /enterprise_support_commands/{document=**} { allow read, write: if false; }
    match /enterprise_support_receipts/{document=**} { allow read, write: if false; }
    match /enterprise_support_evidence_registry/{document=**} { allow read, write: if false; }
    match /enterprise_course_member_scopes/{document=**} { allow read, write: if false; }
    match /enterprise_member_management_commands/{document=**} { allow read, write: if false; }
    match /enterprise_member_management_receipts/{document=**} { allow read, write: if false; }
    match /enterprise_member_import_previews/{document=**} { allow read, write: if false; }
    match /enterprise_member_admin_commands/{document=**} { allow read, write: if false; }
    match /enterprise_member_admin_receipts/{document=**} { allow read, write: if false; }
    match /enterprise_member_delivery_outbox/{document=**} { allow read, write: if false; }
    match /enterprise_member_delivery_workflows/{document=**} { allow read, write: if false; }
    match /enterprise_member_delivery_templates/{document=**} { allow read, write: if false; }
    match /enterprise_member_delivery_policies/{document=**} { allow read, write: if false; }
    match /enterprise_member_delivery_suppressions/{document=**} { allow read, write: if false; }
    match /enterprise_member_report_ready_events/{document=**} { allow read, write: if false; }
  }
}
