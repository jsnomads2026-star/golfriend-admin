# Copy this file to `.env.partner-authority-local` for the local session only.
# Do not commit the copy. It must contain no App Check debug token.
VITE_FIREBASE_PROJECT=partner-authority-local
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
VITE_EMU_AUTH_PORT=9099
VITE_EMU_FIRESTORE_PORT=8080
VITE_EMU_FUNCTIONS_PORT=5001
VITE_EMU_STORAGE_PORT=9199
# Obtain the existing V2 Web app's registered provider and its site key from
# App Check. The provider key is not an App Check debug token.
VITE_PARTNER_AUTHORITY_APPCHECK_PROVIDER=
VITE_PARTNER_AUTHORITY_APPCHECK_SITE_KEY=
